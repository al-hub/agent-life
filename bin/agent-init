#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"

usage() {
  cat <<'EOF'
agent-init - personal AI runtime bootstrap

Usage:
  agent-init help
  agent-init status [--verbose]
  agent-init list [--verbose]
  agent-init auto [--verbose]
  agent-init doctor [--verbose]
  agent-init version

Commands:
  help      Show this help.
  status    Show framework, core, state, and profile status.
  list      List discovered profiles from agent-core/profiles.
  auto      Select a profile from discovered profiles using local context.
  doctor    Run best-effort runtime diagnostics without changing state.
  version   Show agent-init version.

Design:
  command = action
  argument = target
  options stay minimal
EOF
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

script_dir() {
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd
}

framework_root() {
  local dir
  dir="$(script_dir)"

  if [ "$(basename -- "$dir")" = "bin" ] && [ -f "$dir/../README.md" ]; then
    cd -- "$dir/.." && pwd
    return 0
  fi

  if git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$dir" rev-parse --show-toplevel
    return 0
  fi

  pwd
}

state_path() {
  if [ -n "${AGENT_STATE_PATH:-}" ]; then
    printf '%s\n' "$AGENT_STATE_PATH"
  else
    printf '%s\n' "$HOME/.local/state/agent-life"
  fi
}

discover_core() {
  local root
  root="$1"

  if [ -n "${AGENT_CORE_PATH:-}" ]; then
    printf '%s|%s\n' "$AGENT_CORE_PATH" "AGENT_CORE_PATH"
  elif [ -d "$root/../agent-core" ]; then
    printf '%s|%s\n' "$(cd -- "$root/../agent-core" && pwd)" "sibling"
  elif [ -d "$HOME/.agent-core" ]; then
    printf '%s|%s\n' "$HOME/.agent-core" "home"
  else
    printf '%s|%s\n' "" "missing"
  fi
}

core_path_from_result() {
  printf '%s\n' "${1%%|*}"
}

core_source_from_result() {
  printf '%s\n' "${1#*|}"
}

profiles_dir() {
  printf '%s/profiles\n' "$1"
}

list_profiles_raw() {
  local core profiles name found
  core="$1"
  profiles="$(profiles_dir "$core")"
  found=0

  if [ -z "$core" ] || [ ! -d "$profiles" ]; then
    return 0
  fi

  for path in "$profiles"/*; do
    [ -d "$path" ] || continue
    name="$(basename -- "$path")"
    case "$name" in
      .*|'') continue ;;
    esac
    printf '%s\n' "$name"
    found=1
  done

  return 0
}

join_profiles() {
  awk 'BEGIN { first = 1 } { if (!first) printf ", "; printf "%s", $0; first = 0 } END { if (first) printf "none" }'
}

profile_count() {
  awk 'NF { count += 1 } END { printf "%d", count }'
}

say() {
  local level message
  level="$1"
  message="$2"
  printf '[%s] %s\n' "$level" "$message"
}

detail() {
  printf '     %s\n' "$1"
}

warn_detail() {
  printf '       %s\n' "$1"
}

print_core_discovery_reasoning() {
  local root
  root="$1"

  say "INFO" "Checking AGENT_CORE_PATH"
  if [ -n "${AGENT_CORE_PATH:-}" ]; then
    detail "Value: $AGENT_CORE_PATH"
  fi

  say "INFO" "Checking sibling ../agent-core"
  detail "Path: $root/../agent-core"

  say "INFO" "Checking home ~/.agent-core"
  detail "Path: $HOME/.agent-core"
}

print_status() {
  local verbose root state core_result core core_source profiles joined
  verbose="$1"
  root="$(framework_root)"
  state="$(state_path)"
  core_result="$(discover_core "$root")"
  core="$(core_path_from_result "$core_result")"
  core_source="$(core_source_from_result "$core_result")"
  joined="$(list_profiles_raw "$core" | join_profiles)"

  say "OK" "Framework detected"
  detail "Path: $root"

  if [ -n "$core" ]; then
    say "OK" "Core path found"
    detail "Path: $core"
    detail "Source: $core_source"
  else
    say "WARN" "Core path not found"
    warn_detail "Source: $core_source"
  fi

  say "INFO" "State path"
  detail "Path: $state"

  if [ "$joined" = "none" ]; then
    say "WARN" "Profiles: none"
  else
    say "OK" "Profiles: $joined"
  fi

  if [ "$verbose" = "1" ]; then
    echo
    echo "Reasoning:"
    print_core_discovery_reasoning "$root"

    echo
    echo "Diagnostics:"
    if [ -n "$core" ] && git -C "$core" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      say "OK" "Core git repository detected"
    elif [ -n "$core" ]; then
      say "WARN" "Core path is not a git repository"
    else
      say "WARN" "Core git repository unavailable"
    fi

    if [ -n "$core" ] && [ -d "$(profiles_dir "$core")" ]; then
      say "OK" "Profiles directory found"
      detail "Path: $(profiles_dir "$core")"
    else
      say "WARN" "Profiles directory missing"
      say "INFO" "Public sample profiles are ignored for runtime discovery"
    fi
  fi
}

print_profiles() {
  local verbose root core_result core profiles joined count
  verbose="$1"
  root="$(framework_root)"
  core_result="$(discover_core "$root")"
  core="$(core_path_from_result "$core_result")"

  if [ -z "$core" ]; then
    say "WARN" "Core path not found"
    say "WARN" "Profiles: none"
    if [ "$verbose" = "1" ]; then
      echo
      echo "Reasoning:"
      print_core_discovery_reasoning "$root"
      say "INFO" "Public sample profiles are ignored for runtime discovery"
    fi
    return 1
  fi

  profiles="$(profiles_dir "$core")"
  if [ ! -d "$profiles" ]; then
    say "OK" "Core path found"
    detail "Path: $core"
    say "WARN" "Profiles directory missing"
    say "WARN" "Profiles: none"
    return 1
  fi

  joined="$(list_profiles_raw "$core" | join_profiles)"
  count="$(list_profiles_raw "$core" | profile_count)"

  if [ "$count" -gt 0 ]; then
    say "OK" "Profiles discovered: $joined"
    list_profiles_raw "$core" | awk '{ print "     - " $0 }'
  else
    say "WARN" "No runtime profiles discovered"
  fi

  if [ "$verbose" = "1" ]; then
    echo
    echo "Reasoning:"
    print_core_discovery_reasoning "$root"
    say "INFO" "Runtime profiles directory"
    detail "Path: $profiles"
    say "INFO" "Public sample profiles are ignored for runtime discovery"
  fi
}

auto_profile() {
  local verbose root core_result core cwd_name profile count selected
  verbose="$1"
  root="$(framework_root)"
  core_result="$(discover_core "$root")"
  core="$(core_path_from_result "$core_result")"
  cwd_name="$(basename -- "$PWD")"
  count=0
  selected=""

  if [ -z "$core" ]; then
    say "WARN" "Core path not found"
    say "INFO" "Auto Profile: none"
    say "INFO" "Reason: agent-core was not found"
    return 1
  fi

  while IFS= read -r profile; do
    [ -n "$profile" ] || continue
    count=$((count + 1))
    if [ "$profile" = "$cwd_name" ]; then
      selected="$profile"
    fi
  done <<EOF
$(list_profiles_raw "$core")
EOF

  if [ -n "$selected" ]; then
    say "OK" "Auto Profile: $selected"
    say "INFO" "Reason: current directory name matches a discovered profile"
  elif [ "$count" -eq 1 ]; then
    selected="$(list_profiles_raw "$core")"
    say "OK" "Auto Profile: $selected"
    say "INFO" "Reason: only one profile is available"
  else
    say "INFO" "Auto Profile: none"
    say "INFO" "Reason: no unambiguous profile match"
  fi

  if [ "$verbose" = "1" ]; then
    echo
    echo "Reasoning:"
    say "INFO" "Current directory"
    detail "Path: $PWD"
    say "INFO" "Framework path"
    detail "Path: $root"
    say "INFO" "Core path"
    detail "Path: $core"
    say "INFO" "Runtime profiles"
    detail "Profiles: $(list_profiles_raw "$core" | join_profiles)"
  fi
}

print_doctor() {
  local verbose root state state_parent core_result core core_source profiles joined count shell_name
  verbose="$1"
  root="$(framework_root)"
  state="$(state_path)"
  state_parent="$(dirname -- "$state")"
  core_result="$(discover_core "$root")"
  core="$(core_path_from_result "$core_result")"
  core_source="$(core_source_from_result "$core_result")"
  profiles="$(list_profiles_raw "$core")"
  joined="$(printf '%s\n' "$profiles" | join_profiles)"
  count="$(printf '%s\n' "$profiles" | profile_count)"
  shell_name="$(basename -- "${SHELL:-unknown}")"

  echo "agent-init doctor"
  echo

  if [ -d "$root" ] && [ -f "$root/README.md" ]; then
    say "OK" "Framework detected"
    if [ "$verbose" = "1" ]; then
      detail "Path: $root"
    fi
  else
    say "WARN" "Framework root is incomplete"
    if [ "$verbose" = "1" ]; then
      warn_detail "Path: $root"
    fi
  fi

  if command -v git >/dev/null 2>&1; then
    say "OK" "git command found"
  else
    say "WARN" "git command not found"
  fi

  if [ -n "${AGENT_CORE_PATH:-}" ]; then
    say "INFO" "AGENT_CORE_PATH set"
    if [ "$verbose" = "1" ]; then
      detail "Value: $AGENT_CORE_PATH"
    fi
  else
    say "WARN" "AGENT_CORE_PATH not set"
  fi

  if [ "$verbose" = "1" ]; then
    echo
    echo "Reasoning:"
    print_core_discovery_reasoning "$root"
    echo
    echo "Diagnostics:"
  fi

  if [ -n "$core" ]; then
    say "OK" "Core path found"
    if [ "$verbose" = "1" ]; then
      detail "Path: $core"
      detail "Source: $core_source"
    fi

    if git -C "$core" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      say "OK" "Core repository detected"
    else
      say "WARN" "Core path is not a git repository"
    fi
  else
    say "WARN" "Core path not found"
  fi

  if [ "$count" -gt 0 ]; then
    say "OK" "Profiles discovered: $joined"
  elif [ -n "$core" ]; then
    say "WARN" "No runtime profiles discovered"
  else
    say "WARN" "Profile discovery unavailable"
    if [ "$verbose" = "1" ]; then
      say "INFO" "Public sample profiles are ignored for runtime discovery"
    fi
  fi

  if [ -d "$state" ]; then
    if [ -r "$state" ] && [ -w "$state" ]; then
      say "OK" "State directory accessible"
    else
      say "WARN" "State directory exists but may not be readable/writable"
    fi
  elif [ -d "$state_parent" ] && [ -w "$state_parent" ]; then
    say "OK" "State parent directory writable"
    if [ "$verbose" = "1" ]; then
      detail "State Path: $state"
    fi
  else
    say "WARN" "State directory not present"
    if [ "$verbose" = "1" ]; then
      warn_detail "State Path: $state"
    fi
  fi

  say "INFO" "Shell: $shell_name"
  echo
  echo "Notes:"
  echo "- doctor is best-effort informational diagnostics."
  echo "- WARN does not always mean runtime failure."
  echo "- doctor does not repair, activate, switch, sync, or write runtime state."
}

parse_verbose() {
  local verbose arg
  verbose=0
  for arg in "$@"; do
    case "$arg" in
      --verbose) verbose=1 ;;
      *) die "unknown option: $arg" ;;
    esac
  done
  printf '%s\n' "$verbose"
}

main() {
  local command verbose
  command="${1:-help}"
  shift || true

  case "$command" in
    help|-h|--help)
      usage
      ;;
    status)
      verbose="$(parse_verbose "$@")"
      print_status "$verbose"
      ;;
    list)
      verbose="$(parse_verbose "$@")"
      print_profiles "$verbose"
      ;;
    auto)
      verbose="$(parse_verbose "$@")"
      auto_profile "$verbose"
      ;;
    doctor)
      verbose="$(parse_verbose "$@")"
      print_doctor "$verbose"
      ;;
    version)
      echo "agent-init $VERSION"
      ;;
    *)
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
