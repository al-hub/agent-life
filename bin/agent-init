#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"

usage() {
  cat <<'EOF'
agent-init - prepare AI-ready work context

Usage:
  agent-init <command>
  agent-init <context>

Current commands:
  help       Show this help
  doctor     Run environment diagnostics
  status     Show framework/core/state summary
  list       List discovered profiles
  auto       Recommend a profile only
  ready      Prepare an AI work briefing
  select     Select one project-local AI context
  remove     Remove project-local agent-life selection
  fzf        Search, preview, and select a context with fzf
  version    Show installed version

Shortcut:
  agent-init <context>
    Shortcut for: agent-init select <context>

Current role:
  agent-init is a lightweight observer/recommender.
  It does not activate profiles, mutate shell state, attach sessions, or orchestrate runtime.

Reserved commands:
  help, doctor, status, list, auto, version, ready, select, remove, fzf, update

Important:
  Context selection writes only a reversible project-local AGENTS.md marker block.
  It is not activation, attach, shell mutation, write current-profile, or orchestration.
EOF
}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

script_dir() {
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd
}

script_path() {
  local source dir
  source="${BASH_SOURCE[0]}"

  case "$source" in
    */*)
      dir="$(cd -- "$(dirname -- "$source")" && pwd)"
      printf '%s/%s\n' "$dir" "$(basename -- "$source")"
      ;;
    *)
      command -v -- "$source"
      ;;
  esac
}

framework_root() {
  local dir
  dir="$(script_dir)"

  if [ "$(basename -- "$dir")" = "bin" ] && [ -f "$dir/../README.md" ]; then
    cd -- "$dir/.." && pwd
    return 0
  fi

  if git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$dir" rev-parse --show-toplevel
    return 0
  fi

  pwd
}

load_core_discovery_helper() {
  local helper
  helper="$(framework_root)/lib/core-discovery.sh"

  [ -r "$helper" ] || die "missing internal helper: $helper"
  . "$helper"
}

load_core_discovery_helper

state_path() {
  if [ -n "${AGENT_STATE_PATH:-}" ]; then
    printf '%s\n' "$AGENT_STATE_PATH"
  else
    printf '%s\n' "$HOME/.local/state/agent-life"
  fi
}

profiles_dir() {
  printf '%s/profiles\n' "$1"
}

public_profiles_dir() {
  printf '%s/profiles\n' "$1"
}

list_profile_names_from_dir() {
  local profiles path name
  profiles="$1"

  if [ ! -d "$profiles" ]; then
    return 0
  fi

  for path in "$profiles"/*; do
    [ -d "$path" ] || continue
    name="$(basename -- "$path")"
    case "$name" in
      .*|'') continue ;;
    esac
    printf '%s\n' "$name"
  done
}

list_private_profiles_raw() {
  local core profiles name
  core="$1"
  profiles="$(profiles_dir "$core")"

  if [ -z "$core" ] || [ ! -d "$profiles" ]; then
    return 0
  fi

  for path in "$profiles"/*; do
    [ -d "$path" ] || continue
    name="$(basename -- "$path")"
    case "$name" in
      .*|'') continue ;;
    esac
    printf '%s\n' "$name"
  done

  return 0
}

list_contexts_raw() {
  local root core
  root="$1"
  core="$2"

  {
    list_private_profiles_raw "$core"
    list_profile_names_from_dir "$(public_profiles_dir "$root")"
  } | awk 'NF && !seen[$0] { seen[$0] = 1; print }'
}

context_source_path_or_empty() {
  local root core context private_source public_source
  root="$1"
  core="$2"
  context="$3"

  if [ -n "$core" ]; then
    private_source="$core/profiles/$context/AGENTS.md"
    if [ -f "$private_source" ]; then
      printf '%s\n' "$private_source"
      return 0
    fi
  else
    private_source="<agent-core>/profiles/$context/AGENTS.md"
  fi

  public_source="$(public_profiles_dir "$root")/$context/AGENTS.md"
  if [ -f "$public_source" ]; then
    printf '%s\n' "$public_source"
    return 0
  fi

  return 1
}

context_source_path() {
  local root core context private_source public_source source
  root="$1"
  core="$2"
  context="$3"

  if source="$(context_source_path_or_empty "$root" "$core" "$context")"; then
    printf '%s\n' "$source"
    return 0
  fi

  if [ -n "$core" ]; then
    private_source="$core/profiles/$context/AGENTS.md"
  else
    private_source="<agent-core>/profiles/$context/AGENTS.md"
  fi
  public_source="$(public_profiles_dir "$root")/$context/AGENTS.md"

  die "selected context source missing: $private_source or $public_source"
}

profile_description() {
  local root core profile file description
  root="$1"
  core="$2"
  profile="$3"
  file="$(context_source_path_or_empty "$root" "$core" "$profile" || true)"
  description="-"

  if [ -r "$file" ]; then
    description="$(awk '
      /^Description:[[:space:]]*/ {
        sub(/^Description:[[:space:]]*/, "")
        print
        found = 1
        exit
      }
      END {
        if (!found) {
          exit 1
        }
      }
    ' "$file" 2>/dev/null || true)"
    [ -n "$description" ] || description="-"
  fi

  printf '%s\n' "$description" | tr '\t' ' '
}

context_intent() {
  local file intent
  file="$1"
  intent=""

  if [ -r "$file" ]; then
    intent="$(awk '
      /^Intent:[[:space:]]*/ {
        sub(/^Intent:[[:space:]]*/, "")
        print
        found = 1
        exit
      }
      END {
        if (!found) {
          exit 1
        }
      }
    ' "$file" 2>/dev/null || true)"
    [ -n "$intent" ] || intent=""
  fi

  printf '%s\n' "$intent" | tr '\t' ' '
}

list_contexts_tsv() {
  local root core profile description
  root="$1"
  core="$2"

  while IFS= read -r profile; do
    [ -n "$profile" ] || continue
    description="$(profile_description "$root" "$core" "$profile")"
    printf '%s\t%s\n' "$profile" "$description"
  done <<EOF
$(list_contexts_raw "$root" "$core")
EOF
}

join_profiles() {
  awk 'BEGIN { first = 1 } { if (!first) printf ", "; printf "%s", $0; first = 0 } END { if (first) printf "none" }'
}

profile_count() {
  awk 'NF { count += 1 } END { printf "%d", count }'
}

profile_candidate_result() {
  local root core cwd_name count selected profile
  root="$1"
  core="$2"
  cwd_name="$(basename -- "$PWD")"
  count=0
  selected=""

  while IFS= read -r profile; do
    [ -n "$profile" ] || continue
    count=$((count + 1))
    if [ "$profile" = "$cwd_name" ]; then
      selected="$profile"
    fi
  done <<EOF
$(list_contexts_raw "$root" "$core")
EOF

  if [ -n "$selected" ]; then
    printf '%s|%s|%s\n' "$selected" "OK" "current directory name matches a discovered profile"
  elif [ "$count" -eq 1 ]; then
    selected="$(list_contexts_raw "$root" "$core")"
    printf '%s|%s|%s\n' "$selected" "OK" "only one profile is available"
  else
    printf '%s|%s|%s\n' "none" "WARN" "no unambiguous profile match"
  fi
}

requested_profile_result() {
  local root core requested
  root="$1"
  core="$2"
  requested="$3"

  if context_source_path_or_empty "$root" "$core" "$requested" >/dev/null 2>&1; then
    printf '%s|%s|%s\n' "$requested" "OK" "requested context exists"
  else
    printf '%s|%s|%s\n' "$requested" "WARN" "requested context is missing"
  fi
}

print_profile_candidate() {
  local label result profile level reason
  label="$1"
  result="$2"
  IFS='|' read -r profile level reason <<EOF
$result
EOF

  say "$level" "$label: $profile"
  say "INFO" "Reason: $reason"
}

say() {
  local level message
  level="$1"
  message="$2"
  printf '[%s] %s\n' "$level" "$message"
}

detail() {
  printf '     %s\n' "$1"
}

warn_detail() {
  printf '       %s\n' "$1"
}

marker_start() {
  printf '%s\n' "<!-- agent-life:start -->"
}

marker_end() {
  printf '%s\n' "<!-- agent-life:end -->"
}

project_agents_path() {
  printf '%s/AGENTS.md\n' "$PWD"
}

marker_token_count() {
  local file token count
  file="$1"
  token="$2"

  count="$(grep -F -x -c "$token" "$file" 2>/dev/null || true)"
  printf '%s\n' "$count"
}

marker_state() {
  local file start_count end_count
  file="$1"

  if [ ! -e "$file" ]; then
    printf '%s\n' "missing"
    return 0
  fi

  start_count="$(marker_token_count "$file" "$(marker_start)")"
  end_count="$(marker_token_count "$file" "$(marker_end)")"

  if [ "$start_count" -eq 0 ] && [ "$end_count" -eq 0 ]; then
    printf '%s\n' "none"
  elif [ "$start_count" -eq 1 ] && [ "$end_count" -eq 1 ]; then
    if awk -v start="$(marker_start)" -v end="$(marker_end)" '
      $0 == start {
        if (seen_start || seen_end) {
          exit 1
        }
        seen_start = 1
        next
      }
      $0 == end {
        if (!seen_start || seen_end) {
          exit 1
        }
        seen_end = 1
        next
      }
      END {
        if (!seen_start || !seen_end) {
          exit 1
        }
      }
    ' "$file"; then
      printf '%s\n' "found"
    else
      printf '%s\n' "malformed"
    fi
  else
    printf '%s\n' "malformed"
  fi
}

marker_field() {
  local file field
  file="$1"
  field="$2"

  awk -v start="$(marker_start)" -v end="$(marker_end)" -v field="$field" '
    $0 == start { in_block = 1; next }
    $0 == end { in_block = 0; want = ""; next }
    !in_block { next }
    field == "context" && $0 == "Selected context:" { want = "context"; next }
    field == "source" && $0 == "Read first:" { want = "source"; next }
    want && $0 ~ /^- / { print substr($0, 3); exit }
  ' "$file"
}

marker_outside_has_content() {
  local file
  file="$1"

  awk -v start="$(marker_start)" -v end="$(marker_end)" '
    $0 == start { in_block = 1; next }
    $0 == end { in_block = 0; next }
    !in_block { print }
  ' "$file" | grep -q '[^[:space:]]'
}

selected_context_block() {
  local context source intent
  context="$1"
  source="$2"
  intent="$(context_intent "$source")"

  printf '%s\n' "<!-- agent-life:start -->"
  printf '%s\n' "## Agent-life selected context"
  printf '\n'
  printf '%s\n' "Selected context:"
  printf '%s\n' "- $context"
  if [ -n "$intent" ]; then
    printf '\n'
    printf '%s\n' "Intent:"
    printf '%s\n' "- $intent"
  fi
  cat <<EOF

Read first:
- $source

Rules:
- Treat this context as guidance for the current AI session.
- Do not modify agent-core files unless explicitly asked.
- Follow project AGENTS.md and selected context together.
- This is not activation, orchestration, or shell/runtime mutation.
<!-- agent-life:end -->
EOF
}

write_project_marker() {
  local file block state tmp
  file="$1"
  block="$2"
  state="$(marker_state "$file")"

  case "$state" in
    missing)
      printf '%s\n' "$block" > "$file"
      ;;
    none)
      tmp="$(mktemp)"
      if [ -s "$file" ]; then
        cat "$file" > "$tmp"
        printf '\n\n%s\n' "$block" >> "$tmp"
      else
        printf '%s\n' "$block" > "$tmp"
      fi
      mv "$tmp" "$file"
      ;;
    found)
      tmp="$(mktemp)"
      awk -v start="$(marker_start)" -v end="$(marker_end)" -v block="$block" '
        $0 == start { print block; in_block = 1; next }
        $0 == end { in_block = 0; next }
        !in_block { print }
      ' "$file" > "$tmp"
      mv "$tmp" "$file"
      ;;
    malformed)
      die "project AGENTS.md has malformed agent-life marker block; repair manually"
      ;;
  esac
}

remove_project_marker() {
  local file state tmp
  file="$1"
  state="$(marker_state "$file")"

  case "$state" in
    missing|none)
      say "INFO" "Agent-life marker block: missing"
      detail "Selected context: none"
      return 0
      ;;
    malformed)
      die "project AGENTS.md has malformed agent-life marker block; repair manually"
      ;;
    found)
      if ! marker_outside_has_content "$file"; then
        rm -f -- "$file"
        say "OK" "Removed project AGENTS.md"
        detail "Reason: file contained only the agent-life marker block"
        return 0
      fi

      tmp="$(mktemp)"
      awk -v start="$(marker_start)" -v end="$(marker_end)" '
        $0 == start { in_block = 1; next }
        $0 == end { in_block = 0; next }
        !in_block { print }
      ' "$file" > "$tmp"
      mv "$tmp" "$file"
      say "OK" "Removed agent-life marker block"
      detail "Path: $file"
      ;;
  esac
}

print_core_discovery_reasoning() {
  local root label path value
  root="$1"

  agent_life_core_discovery_reasoning "$root" | while IFS='|' read -r label path value; do
    say "INFO" "Checking $label"
    if [ -n "$path" ]; then
      detail "Path: $path"
    fi
    if [ -n "$value" ]; then
      detail "Value: $value"
    fi
  done
}

print_status() {
  local verbose root state core_result core core_source profiles joined project agents marker selected source
  verbose="$1"
  root="$(framework_root)"
  state="$(state_path)"
  core_result="$(agent_life_discover_core "$root")"
  core="$(agent_life_core_path_from_result "$core_result")"
  core_source="$(agent_life_core_source_from_result "$core_result")"
  joined="$(list_contexts_raw "$root" "$core" | join_profiles)"
  project="$PWD"
  agents="$(project_agents_path)"
  marker="$(marker_state "$agents")"
  selected="none"
  source="none"

  say "OK" "Framework detected"
  detail "Path: $root"

  if [ -n "$core" ]; then
    say "OK" "Core path found"
    detail "Path: $core"
    detail "Source: $core_source"
  else
    say "WARN" "Core path not found"
    warn_detail "Source: $core_source"
  fi

  say "INFO" "State path"
  detail "Path: $state"

  say "INFO" "Project path"
  detail "Path: $project"

  if [ -f "$agents" ]; then
    say "OK" "Project AGENTS.md: found"
    detail "Path: $agents"
  else
    say "INFO" "Project AGENTS.md: missing"
  fi

  case "$marker" in
    found)
      selected="$(marker_field "$agents" "context")"
      source="$(marker_field "$agents" "source")"
      [ -n "$selected" ] || selected="none"
      [ -n "$source" ] || source="none"
      say "OK" "Agent-life marker block: found"
      detail "Selected context: $selected"
      detail "Context source: $source"
      if [ "$source" != "none" ] && [ ! -f "$source" ]; then
        say "WARN" "Selected context source missing"
        warn_detail "Path: $source"
      fi
      ;;
    malformed)
      say "WARN" "Agent-life marker block: malformed"
      warn_detail "Manual repair is required before select/remove can modify AGENTS.md"
      ;;
    missing|none)
      say "INFO" "Agent-life marker block: missing"
      detail "Selected context: none"
      detail "Context source: none"
      ;;
  esac

  if [ "$joined" = "none" ]; then
    say "WARN" "Discovered profiles: none"
  else
    say "OK" "Discovered profiles: $joined"
  fi

  if [ "$verbose" = "1" ]; then
    echo
    echo "Reasoning:"
    print_core_discovery_reasoning "$root"

    echo
    echo "Diagnostics:"
    if [ -n "$core" ] && git -C "$core" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      say "OK" "Core git repository detected"
    elif [ -n "$core" ]; then
      say "WARN" "Core path is not a git repository"
    else
      say "WARN" "Core git repository unavailable"
    fi

    if [ -n "$core" ] && [ -d "$(profiles_dir "$core")" ]; then
      say "OK" "Private profiles directory found"
      detail "Path: $(profiles_dir "$core")"
    else
      say "WARN" "Private profiles directory missing"
    fi

    if [ -d "$(public_profiles_dir "$root")" ]; then
      say "OK" "Public profiles directory found"
      detail "Path: $(public_profiles_dir "$root")"
    else
      say "WARN" "Public profiles directory missing"
    fi
  fi
}

select_context() {
  local context root core_result core source agents block
  context="${1:-}"

  [ -n "$context" ] || die "select requires one context argument"
  case "$context" in
    */*|.*|"") die "invalid context name: $context" ;;
    *[!abcdefghijklmnopqrstuvwxyz0123456789-]*)
      die "invalid context name: $context"
      ;;
    help|doctor|status|list|auto|ready|select|remove|fzf|version|update)
      die "reserved command cannot be used as context: $context"
      ;;
  esac

  root="$(framework_root)"
  core_result="$(agent_life_discover_core "$root")"
  core="$(agent_life_core_path_from_result "$core_result")"
  source="$(context_source_path "$root" "$core" "$context")"

  agents="$(project_agents_path)"
  block="$(selected_context_block "$context" "$source")"
  write_project_marker "$agents" "$block"

  say "OK" "Selected project context: $context"
  detail "Project: $PWD"
  detail "AGENTS.md: $agents"
  detail "Context source: $source"
  say "INFO" "Selection is a project-local read-first reference only."
}

remove_selection() {
  local target agents
  target="${1:-}"
  [ "$target" = "all" ] || die "remove currently supports only: agent-init remove all"

  agents="$(project_agents_path)"
  remove_project_marker "$agents"
}

print_profiles() {
  local verbose format root core_result core private_profiles public_profiles joined count
  verbose="$1"
  format="$2"
  root="$(framework_root)"
  core_result="$(agent_life_discover_core "$root")"
  core="$(agent_life_core_path_from_result "$core_result")"

  private_profiles=""
  if [ -n "$core" ]; then
    private_profiles="$(profiles_dir "$core")"
  fi
  public_profiles="$(public_profiles_dir "$root")"

  joined="$(list_contexts_raw "$root" "$core" | join_profiles)"
  count="$(list_contexts_raw "$root" "$core" | profile_count)"

  if [ "$format" = "tsv" ]; then
    list_contexts_tsv "$root" "$core"
    [ "$count" -gt 0 ]
    return $?
  fi

  if [ -z "$core" ]; then
    say "WARN" "Core path not found"
  fi

  if [ -n "$core" ] && [ ! -d "$private_profiles" ]; then
    say "OK" "Core path found"
    detail "Path: $core"
    say "WARN" "Private profiles directory missing"
  fi

  if [ "$count" -gt 0 ]; then
    say "OK" "Discovered profiles: $joined"
    list_contexts_raw "$root" "$core" | awk '{ print "     - " $0 }'
  else
    say "WARN" "Discovered profiles: none"
  fi

  if [ "$verbose" = "1" ]; then
    echo
    echo "Reasoning:"
    print_core_discovery_reasoning "$root"
    if [ -n "$private_profiles" ]; then
      say "INFO" "Private profiles directory"
      detail "Path: $private_profiles"
    fi
    say "INFO" "Public profiles directory"
    detail "Path: $public_profiles"
    say "INFO" "Discovery priority: private overrides public by context name"
  fi
}

print_fzf_fallback() {
  say "WARN" "fzf command not found"
  say "INFO" "Install fzf to use the interactive selector."
  echo
  echo "Fallback commands:"
  echo "  agent-init list"
  echo "  agent-init ready <context>"
  echo "  agent-init select <context>"
  echo "  agent-init remove all"
}

run_fzf_selector() {
  local self rows selected context
  self="$(script_path)"

  if ! command -v fzf >/dev/null 2>&1; then
    print_fzf_fallback
    return 0
  fi

  rows="$("$self" list --tsv 2>/dev/null || true)"
  if [ -z "$rows" ]; then
    say "WARN" "No contexts available for fzf"
    say "INFO" "Run agent-init list for discovery diagnostics."
    return 0
  fi

  selected="$(
    printf '%s\n' "$rows" |
      AGENT_INIT_SELF="$self" fzf \
        --delimiter "$(printf '\t')" \
        --with-nth 1,2 \
        --preview '"$AGENT_INIT_SELF" ready {1}' \
        --preview-window 'right:60%:wrap'
  )" || {
    say "INFO" "fzf selection cancelled"
    return 0
  }

  context="$(printf '%s\n' "$selected" | awk -F '\t' '{ print $1 }')"
  if [ -z "$context" ]; then
    say "WARN" "No context selected"
    return 0
  fi

  "$self" select "$context"
}

auto_profile() {
  local verbose root core_result core profile_result
  verbose="$1"
  root="$(framework_root)"
  core_result="$(agent_life_discover_core "$root")"
  core="$(agent_life_core_path_from_result "$core_result")"

  if [ -z "$core" ]; then
    say "WARN" "Core path not found"
  fi

  profile_result="$(profile_candidate_result "$root" "$core")"
  print_profile_candidate "Recommended profile" "$profile_result"

  if [ "$verbose" = "1" ]; then
    echo
    echo "Reasoning:"
    say "INFO" "Current directory"
    detail "Path: $PWD"
    say "INFO" "Framework path"
    detail "Path: $root"
    print_core_discovery_reasoning "$root"
    say "INFO" "Discovered profiles"
    detail "Discovered profiles: $(list_contexts_raw "$root" "$core" | join_profiles)"
  fi
}

print_ready() {
  local root core_result core core_source requested profile_result profile level reason profiles joined count profile_result_label
  root="$(framework_root)"
  core_result="$(agent_life_discover_core "$root")"
  core="$(agent_life_core_path_from_result "$core_result")"
  core_source="$(agent_life_core_source_from_result "$core_result")"
  requested="${1:-}"

  if [ -n "$requested" ]; then
    local source
    source="$(context_source_path "$root" "$core" "$requested")"
    selected_context_block "$requested" "$source"
    return 0
  fi

  profiles="$(list_contexts_raw "$root" "$core")"
  joined="$(list_contexts_raw "$root" "$core" | join_profiles)"
  count="$(list_contexts_raw "$root" "$core" | profile_count)"
  if [ -n "$requested" ]; then
    profile_result="$(requested_profile_result "$root" "$core" "$requested")"
    profile_result_label="Requested profile"
  else
    profile_result="$(profile_candidate_result "$root" "$core")"
    profile_result_label="Suggested profile"
  fi
  IFS='|' read -r profile level reason <<EOF
$profile_result
EOF

  echo "agent-init ready"
  echo

  say "INFO" "Framework"
  say "OK" "Framework detected"
  detail "Path: $root"

  say "INFO" "Core"
  if [ -n "$core" ]; then
    say "OK" "Core path found"
    detail "Path: $core"
    detail "Source: $core_source"
  else
    say "WARN" "Core path not found"
    warn_detail "Source: $core_source"
    warn_detail "Reason: no agent-core was discovered by any configured path"
  fi

  say "INFO" "Discovered profiles"
  if [ "$joined" = "none" ]; then
    say "WARN" "Discovered profiles: none"
  else
    say "OK" "Discovered profiles: $joined"
    if [ "$count" -gt 0 ]; then
      printf '%s\n' "$profiles" | awk '{ print "     - " $0 }'
    fi
  fi

  say "INFO" "Profile"
  say "$level" "$profile_result_label: $profile"
  say "INFO" "Reason: $reason"

  echo
  say "INFO" "Read first"
  detail "README.md"
  detail "AGENTS.md"
  detail "NEXT.md"
  detail "DECISIONS.md"
  detail "docs/what-is-agent-life.md"
  detail "docs/cli.md"
  detail "docs/command-semantics.md"
  detail "docs/ready-concept.md"
  if [ "$profile" != "none" ]; then
    detail "$(context_source_path "$root" "$core" "$profile")"
  fi

  echo
  say "INFO" "Boundary reminders"
  detail "No task execution."
  detail "No profile activation."
  detail "No shell, env, or state mutation."
  detail "No tmux, session, or orchestration."
  detail "No semantic parsing of AGENTS.md."

  echo
  say "INFO" "Suggested verification"
  detail "./bin/agent-init doctor"
  detail "./bin/agent-init status"
  detail "sh tests/smoke/run.sh"

  echo
  say "INFO" "Task brief"
  detail "Goal"
  detail "Boundary"
  detail "Verification"
  detail "Next action"

  echo
  say "INFO" "Read-first files are recommendations only; no automatic parsing or merging occurs."
}

print_doctor() {
  local verbose root state state_parent core_result core core_source profiles joined count shell_name configured_core
  verbose="$1"
  root="$(framework_root)"
  state="$(state_path)"
  state_parent="$(dirname -- "$state")"
  core_result="$(agent_life_discover_core "$root")"
  core="$(agent_life_core_path_from_result "$core_result")"
  core_source="$(agent_life_core_source_from_result "$core_result")"
  profiles="$(list_contexts_raw "$root" "$core")"
  joined="$(printf '%s\n' "$profiles" | join_profiles)"
  count="$(printf '%s\n' "$profiles" | profile_count)"
  shell_name="$(basename -- "${SHELL:-unknown}")"
  configured_core="$(agent_life_config_value "default-core-path")"

  echo "agent-init doctor"
  echo

  if [ -d "$root" ] && [ -f "$root/README.md" ]; then
    say "OK" "Framework detected"
    if [ "$verbose" = "1" ]; then
      detail "Path: $root"
    fi
  else
    say "WARN" "Framework root is incomplete"
    if [ "$verbose" = "1" ]; then
      warn_detail "Path: $root"
    fi
  fi

  if command -v git >/dev/null 2>&1; then
    say "OK" "git command found"
  else
    say "WARN" "git command not found"
  fi

  if [ -n "${AGENT_CORE_PATH:-}" ]; then
    say "INFO" "AGENT_CORE_PATH set"
    if [ "$verbose" = "1" ]; then
      detail "Value: $AGENT_CORE_PATH"
    fi
  else
    say "WARN" "AGENT_CORE_PATH not set"
  fi

  if [ -r "$(agent_life_config_path)" ]; then
    say "INFO" "Local config found"
    if [ "$verbose" = "1" ]; then
      detail "Path: $(agent_life_config_path)"
      if [ -n "$configured_core" ]; then
        detail "default-core-path: $(agent_life_expand_user_path "$configured_core")"
      else
        detail "default-core-path: unset"
      fi
    fi
  else
    say "INFO" "Local config not found"
    if [ "$verbose" = "1" ]; then
      detail "Path: $(agent_life_config_path)"
    fi
  fi

  if [ "$verbose" = "1" ]; then
    echo
    echo "Reasoning:"
    print_core_discovery_reasoning "$root"
    echo
    echo "Diagnostics:"
  fi

  if [ -n "$core" ]; then
    say "OK" "Core path found"
    if [ "$verbose" = "1" ]; then
      detail "Path: $core"
      detail "Source: $core_source"
    fi

    if git -C "$core" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      say "OK" "Core repository detected"
    else
      say "WARN" "Core path is not a git repository"
    fi
  else
    say "WARN" "Core path not found"
  fi

  if [ "$count" -gt 0 ]; then
    say "OK" "Discovered profiles: $joined"
  elif [ -n "$core" ]; then
    say "WARN" "Discovered profiles: none"
  else
    say "WARN" "Discovered profiles: none"
  fi

  if [ -d "$state" ]; then
    if [ -r "$state" ] && [ -w "$state" ]; then
      say "OK" "State directory accessible"
    else
      say "WARN" "State directory exists but may not be readable/writable"
    fi
  elif [ -d "$state_parent" ] && [ -w "$state_parent" ]; then
    say "OK" "State parent directory writable"
    if [ "$verbose" = "1" ]; then
      detail "State Path: $state"
    fi
  else
    say "WARN" "State directory not present"
    if [ "$verbose" = "1" ]; then
      warn_detail "State Path: $state"
    fi
  fi

  say "INFO" "Shell: $shell_name"
  echo
  echo "Notes:"
  echo "- doctor is diagnostics only."
  echo "- WARN does not always mean runtime failure."
  echo "- doctor does not repair, activate, switch, sync, or write runtime state."
}

parse_verbose() {
  local verbose arg
  verbose=0
  for arg in "$@"; do
    case "$arg" in
      --verbose) verbose=1 ;;
      *) die "unknown option: $arg" ;;
    esac
  done
  printf '%s\n' "$verbose"
}

parse_list_args() {
  local verbose format arg
  verbose=0
  format="human"

  for arg in "$@"; do
    case "$arg" in
      --verbose) verbose=1 ;;
      --tsv) format="tsv" ;;
      *) die "unknown option: $arg" ;;
    esac
  done

  printf '%s|%s\n' "$verbose" "$format"
}

main() {
  local command verbose list_args list_format
  command="${1:-help}"
  shift || true

  case "$command" in
    help|-h|--help)
      usage
      ;;
    status)
      verbose="$(parse_verbose "$@")"
      print_status "$verbose"
      ;;
    list)
      list_args="$(parse_list_args "$@")"
      IFS='|' read -r verbose list_format <<EOF
$list_args
EOF
      print_profiles "$verbose" "$list_format"
      ;;
    auto)
      verbose="$(parse_verbose "$@")"
      auto_profile "$verbose"
      ;;
    ready)
      if [ "$#" -gt 1 ]; then
        die "ready accepts at most one profile argument"
      fi
      print_ready "${1:-}"
      ;;
    select)
      if [ "$#" -ne 1 ]; then
        die "select requires exactly one context argument"
      fi
      select_context "$1"
      ;;
    remove)
      if [ "$#" -ne 1 ]; then
        die "remove currently supports only: agent-init remove all"
      fi
      remove_selection "$1"
      ;;
    update)
      die "update is reserved but not implemented"
      ;;
    fzf)
      if [ "$#" -ne 0 ]; then
        die "fzf accepts no arguments"
      fi
      run_fzf_selector
      ;;
    doctor)
      verbose="$(parse_verbose "$@")"
      print_doctor "$verbose"
      ;;
    version)
      echo "agent-init $VERSION"
      ;;
    *)
      if [ "$#" -eq 0 ]; then
        select_context "$command"
        return 0
      fi
      die "context shortcut accepts exactly one context argument: agent-init <context>"
      ;;
  esac
}

main "$@"
